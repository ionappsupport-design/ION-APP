+                View firstChild = contentViewGroup.getChildAt(0);
+                if (firstChild instanceof ViewGroup) {
+                    mViewGroup = (ViewGroup) firstChild;
+                    return mViewGroup;
+                }
+            }
+        }
+
+        if (mViewGroup != null && mViewGroup.getContext() == activity) {
+            return mViewGroup;
+        }
+
+        return null;
