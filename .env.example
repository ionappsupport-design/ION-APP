# =============================================================================
# ION — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Firebase (REQUIRED — all fields must be set before building) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: enables Firebase Analytics (set to your Measurement ID)
VITE_FIREBASE_MEASUREMENT_ID=

# --- AdMob (REQUIRED for production revenue) ---
# Leave blank to use Google's official test IDs (safe for development/CI).
# Set to your real Ad Unit IDs for production release builds.
VITE_ADMOB_BANNER_ANDROID=
VITE_ADMOB_BANNER_IOS=
# Set to "false" ONLY in production release builds.
# Defaults to "true" (test mode) if unset.
VITE_ADMOB_TESTING=true

# --- Razorpay ---
# Key ID is used by the frontend to initialise the Razorpay checkout.
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id_here

# Key Secret is used for backend signature verification
RAZORPAY_KEY_SECRET=your_key_secret_here

# =============================================================================
# Android runtime prerequisites (not env vars — listed here for reference)
# =============================================================================
# 1. android/app/google-services.json
#    Obtain from Firebase Console → Project Settings → Your Apps
#    Required for: Firebase Auth, Firestore, Analytics, Crashlytics, FCM
#
# 2. AdMob APPLICATION_ID
#    Already set in AndroidManifest.xml to Google test app ID.
#    Replace ca-app-pub-3940256099942544~3347511713 with your real App ID
#    before Play Store submission.
# =============================================================================
